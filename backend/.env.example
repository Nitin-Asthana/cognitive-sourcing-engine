# ─── Sourcing Architect — Backend configuration (template) ───────────────────
# Copy this file to `.env` and fill in values ONLY if you want to enable the
# optional Azure OpenAI engine. The app runs fully without any of these.
#
# NOTE: Authentication uses Entra ID (DefaultAzureCredential) — there is NO
# API key here. Sign in locally with `az login` or VS Code's Azure account.

# Engine mode: "fallback" (default, no credentials) or "live" (Azure OpenAI)
MODE=fallback

# Where the API server binds. Defaults to loopback only (127.0.0.1:8000).
# Use 0.0.0.0 only if you intentionally want to expose it on your network.
HOST=127.0.0.1
PORT=8000

# Required ONLY when MODE=live. Your resource URL — not a secret, but keep it
# in .env rather than committing it.
AZURE_OPENAI_ENDPOINT=

# Optional overrides
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2025-01-01-preview
